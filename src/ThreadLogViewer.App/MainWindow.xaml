<Window x:Class="ThreadLogViewer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Title="ThreadLog Viewer v0.6.2" Width="1360" Height="860" MinWidth="1040" MinHeight="600" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" PreviewKeyDown="Window_KeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" PreviewDragEnter="Window_DragOver" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
  <Window.Resources>
    <Style x:Key="AnalysisToolTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="TabSurface" Padding="10,6" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <DockPanel Background="{DynamicResource BackgroundBrush}">
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,2">
      <Menu x:Name="MainMenu" AutomationProperties.Name="주 메뉴">
        <MenuItem Header="파일(_F)" SubmenuOpened="MainMenu_Opened">
          <MenuItem Header="파일 열기…" InputGestureText="Ctrl+O" Click="Open_Click" />
          <MenuItem Header="클립보드 로그 새 탭으로 열기" InputGestureText="Ctrl+Shift+V" Click="PasteLog_Click" />
          <Separator />
          <MenuItem x:Name="ExportMenu" Header="필터 결과 내보내기…" Click="Export_Click" IsEnabled="{Binding IsEnabled, ElementName=ExportButton}" />
          <MenuItem x:Name="EncodingMenu" Header="인코딩으로 다시 읽기" IsEnabled="False" ToolTip="열 때 자동 판별합니다. 글자가 깨질 때만 인코딩을 직접 선택하세요.">
            <MenuItem Header="자동 판별" Click="ReloadAuto_Click" />
            <MenuItem x:Name="ReloadButton" Header="한국어 (CP949)" Click="Reload_Click" IsEnabled="False" />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="CloseSessionMenu" Header="현재 탭 닫기" InputGestureText="Ctrl+W" Click="CloseActiveSession_Click" IsEnabled="False" />
          <MenuItem Header="종료" InputGestureText="Alt+F4" Click="Exit_Click" />
        </MenuItem>
        <MenuItem Header="편집(_E)" SubmenuOpened="MainMenu_Opened">
          <MenuItem Header="복사" InputGestureText="Ctrl+C" Click="Copy_Click" />
          <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Click="Paste_Click" ToolTip="클립보드의 로그를 새 탭으로 엽니다." />
          <MenuItem Header="전체 선택" InputGestureText="Ctrl+A" Click="SelectText_Click" />
          <Separator />
          <MenuItem x:Name="FindMenu" Header="찾기…" InputGestureText="Ctrl+F" Click="Search_Click" />
          <MenuItem x:Name="FindNextMenu" Header="다음 검색 결과" InputGestureText="F3" Click="Next_Click" />
          <MenuItem x:Name="FindPreviousMenu" Header="이전 검색 결과" InputGestureText="F4" Click="Previous_Click" ToolTip="Shift+F3도 사용할 수 있습니다." />
          <MenuItem x:Name="GoToMenu" Header="원본 줄로 이동…" InputGestureText="Ctrl+G" Click="GoTo_Click" />
        </MenuItem>
        <MenuItem Header="보기(_V)" SubmenuOpened="MainMenu_Opened">
          <MenuItem x:Name="WrapMenu" Header="자동 줄바꿈" IsCheckable="True" Click="MenuWrap_Click" />
          <MenuItem x:Name="FontMenu" Header="글자 크기">
            <MenuItem Header="11" Tag="font:11" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="12" Tag="font:12" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="13" Tag="font:13" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="14" Tag="font:14" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="16" Tag="font:16" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="18" Tag="font:18" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="20" Tag="font:20" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="24" Tag="font:24" IsCheckable="True" Click="MenuAppearance_Click" />
            <Separator />
            <MenuItem Header="크게" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
            <MenuItem Header="작게" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
            <MenuItem Header="기본 크기 (14)" InputGestureText="Ctrl+0" Click="ZoomReset_Click" />
          </MenuItem>
          <MenuItem x:Name="DensityMenu" Header="행 간격">
            <MenuItem Header="기본 간격" Tag="density:0" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="좁은 간격" Tag="density:1" IsCheckable="True" Click="MenuAppearance_Click" />
          </MenuItem>
          <MenuItem x:Name="ThemeMenu" Header="화면 테마">
            <MenuItem Header="다크" Tag="theme:0" IsCheckable="True" Click="MenuAppearance_Click" />
            <MenuItem Header="라이트" Tag="theme:1" IsCheckable="True" Click="MenuAppearance_Click" />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="NextSessionMenu" Header="다음 탭" InputGestureText="Ctrl+Tab" Click="NextSession_Click" IsEnabled="False" />
          <MenuItem x:Name="PreviousSessionMenu" Header="이전 탭" InputGestureText="Ctrl+Shift+Tab" Click="PreviousSession_Click" IsEnabled="False" />
        </MenuItem>
        <MenuItem x:Name="AnalysisMenu" Header="분석(_A)" SubmenuOpened="MainMenu_Opened">
          <MenuItem Header="현재 줄 주변 로그 보기" Tag="line" Click="Context_Click" />
          <MenuItem Header="문구 강조 / 해제" InputGestureText="Shift+F8" Tag="highlight" Click="ToggleHighlight_Click" />
          <MenuItem Header="강조 문구 관리…" Tag="highlight-manager" Click="HighlightSelection_Click" />
          <Separator />
          <MenuItem Header="세션 분리 시작 줄 지정" Tag="line" Click="SplitStart_Click" />
          <MenuItem Header="여기까지 새 탭으로 분리" Tag="split-end" Click="SplitEnd_Click" />
          <MenuItem Header="분리 시작 지정 해제" Tag="split-clear" Click="SplitClear_Click" />
          <Separator />
          <MenuItem Header="현재 줄을 시간 비교 기준으로 지정" Tag="time" Click="TimeA_Click" />
          <MenuItem Header="기준과 현재 줄 시간 차이" Tag="time-compare" Click="TimeB_Click" />
          <MenuItem Header="시간 비교 해제" Tag="time-clear" Click="ClearTime_Click" />
          <Separator />
          <MenuItem Header="현재 줄 북마크 표시 / 해제" InputGestureText="Ctrl+F2" Click="BookmarkToggle_Click" />
          <MenuItem Header="다음 북마크" InputGestureText="F2" Click="NextBookmark_Click" />
          <MenuItem Header="이전 북마크" InputGestureText="Shift+F2" Click="PreviousBookmark_Click" />
          <MenuItem Header="북마크 이름 바꾸기…" Click="BookmarkRename_Click" />
        </MenuItem>
        <MenuItem Header="도움말(_H)">
          <MenuItem Header="단축키와 사용 방법" InputGestureText="F1" Click="Help_Click" />
        </MenuItem>
      </Menu>
    </Border>
    <ListBox x:Name="SessionTabs" DockPanel.Dock="Top" Visibility="Collapsed" SelectionChanged="SessionTab_Selected" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4" Height="44" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="열린 로그 탭">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,0,5,0" /><Setter Property="ToolTip" Value="{Binding ToolTip}" /></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="9,0,3,0" Height="30" MaxWidth="265">
            <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" Click="CloseSession_Click" Padding="3,0" MinWidth="23" MinHeight="24" Margin="6,0,0,0" ToolTip="이 탭 닫기" AutomationProperties.Name="탭 닫기" />
            <TextBlock Text="{Binding DisplayTitle}" MaxWidth="215" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Visibility="Collapsed" DockPanel.Dock="Top">
      <ToggleButton x:Name="WrapBox" Checked="Wrap_Changed" Unchecked="Wrap_Changed" />
      <ComboBox x:Name="FontSizeBox" SelectionChanged="FontSize_Changed" SelectedIndex="3"><ComboBoxItem Content="11" /><ComboBoxItem Content="12" /><ComboBoxItem Content="13" /><ComboBoxItem Content="14" /><ComboBoxItem Content="16" /><ComboBoxItem Content="18" /><ComboBoxItem Content="20" /><ComboBoxItem Content="24" /></ComboBox>
      <ComboBox x:Name="DensityBox" SelectionChanged="Density_Changed" SelectedIndex="0"><ComboBoxItem Content="기본 간격" /><ComboBoxItem Content="좁은 간격" /></ComboBox>
      <ComboBox x:Name="ThemeBox" SelectionChanged="Theme_Changed" SelectedIndex="0"><ComboBoxItem Content="다크" /><ComboBoxItem Content="라이트" /></ComboBox>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CountStatus" Text="0/0건 · 표시 0/0줄" FontSize="11" ToolTip="{Binding Text, ElementName=OperationStatus}" VerticalAlignment="Center" />
        <TextBlock x:Name="EncodingStatus" Grid.Column="1" Text="인코딩: 파일 없음" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="20,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" />
        <TextBlock x:Name="ParseStatus" Grid.Column="2" Text="파싱: 대기" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="PositionStatus" Grid.Column="3" Text="읽기 전용" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="20,0,0,0" VerticalAlignment="Center" ToolTip="열은 문서 열입니다. 선택 글자 수는 Unicode 문자 수이며 CRLF는 2개로 셉니다." />
      </Grid>
    </Border>
    <Border x:Name="WorkPanel" DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="작업 취소" Click="Cancel_Click" Visibility="Collapsed" />
        <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Right" Width="150" Height="5" Minimum="0" Maximum="100" Margin="10,0,15,0" Visibility="Collapsed" />
        <TextBlock x:Name="OperationStatus" Text="로그 파일을 끌어 놓거나 Ctrl+V로 붙여넣으세요." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ThreadColumn" Width="295" MinWidth="275" MaxWidth="600" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PanelBrush}">
        <DockPanel x:Name="FilterPanel" Margin="12,18,12,10">
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="6,0,6,12">
              <TextBlock x:Name="ThreadScopeTitle" Text="스레드 · 전체 파일" FontWeight="SemiBold" />
              <TextBlock x:Name="ThreadCount" Text="0개" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            </DockPanel>
            <TextBlock x:Name="ThreadScopeHint" Text="건수와 시간은 전체 파일 기준입니다." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="6,0,0,8" />
            <TextBlock x:Name="FilterModeHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="6,0,0,8" Visibility="Collapsed" />
            <StackPanel x:Name="ThreadFilterControls" Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding CanChangeFilters, RelativeSource={RelativeSource AncestorType=Window}}">
              <Button Content="전체 선택" Click="SelectAll_Click" FontSize="12" Padding="7,5" MinHeight="28" />
              <Button Content="전체 해제" Click="SelectNone_Click" FontSize="12" Padding="7,5" MinHeight="28" />
            </StackPanel>
            <Expander x:Name="ContentFilterExpander" Header="내용 필터" Margin="4,0,4,12" Foreground="{DynamicResource TextBrush}">
              <StackPanel x:Name="TextFilterControls" Margin="0,8,0,0" IsEnabled="{Binding CanChangeFilters, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="보여줄 기록 · 한 줄에 한 문구" FontSize="12" />
                <TextBox x:Name="IncludeBox" AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto" ToolTip="예: Write · 비워두면 내용 제한 없음" TextChanged="Criteria_Changed" />
                <ComboBox x:Name="IncludeModeBox" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="FilterOption_Changed" AutomationProperties.Name="포함 문구 일치 방식"><ComboBoxItem Content="하나라도 포함된 기록" /><ComboBoxItem Content="모두 포함된 기록" /></ComboBox>
                <TextBlock Text="숨길 기록 · 한 줄에 한 문구" FontSize="12" Margin="0,10,0,0" />
                <TextBox x:Name="ExcludeBox" AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto" ToolTip="예: heartbeat · 하나라도 포함되면 기록 전체를 숨김" TextChanged="Criteria_Changed" />
                <CheckBox x:Name="FilterCaseBox" Content="대소문자 구분" Margin="0,8,0,6" Checked="FilterOption_Changed" Unchecked="FilterOption_Changed" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="필터 적용" Click="ApplyTextFilter_Click" />
                  <Button Content="내용 필터 해제" Click="ResetTextFilter_Click" />
                </StackPanel>
                <TextBlock x:Name="FilterDirtyStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                <TextBlock x:Name="FilterSummary" Text="현재 적용: 내용 제한 없음" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <Expander x:Name="BookmarkPanel" DockPanel.Dock="Bottom" Header="북마크 · Ctrl+F2 / F2" Foreground="{DynamicResource TextBrush}" Margin="4,8" MaxHeight="220">
            <StackPanel Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="표시 / 해제" Click="BookmarkToggle_Click" FontSize="11" />
                <Button Content="이름" Click="BookmarkRename_Click" FontSize="11" />
              </StackPanel>
              <ListBox x:Name="BookmarkList" MaxHeight="140" DisplayMemberPath="Label" SelectionChanged="Bookmark_Selected" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
            </StackPanel>
          </Expander>
          <TextBlock DockPanel.Dock="Bottom" Text="최초 → 마지막 기록 · 파일 순서" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="6,12,0,0" />
          <ListBox x:Name="ThreadList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="7,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="단독" ToolTip="이 스레드만 보기" Padding="5,2" FontSize="11" MinHeight="24" Margin="4,0,0,0" Tag="{Binding}" Click="Only_Click" IsEnabled="{Binding CanChangeFilters, RelativeSource={RelativeSource AncestorType=Window}}" />
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding CanChangeFilters, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Label}" />
                      <Ellipse Fill="{Binding Color}" Width="8" Height="8" Margin="5,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding CountLabel}" ToolTip="{Binding DetailedTimes}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Times}" ToolTip="{Binding DetailedTimes}" FontFamily="Consolas, Malgun Gothic" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="24,8,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,9">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="False" ToolTip="표시 중인 로그를 새 UTF-8 파일로 내보내기" AutomationProperties.Name="필터 결과 내보내기">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ToolbarIcon}" Text="" />
                  <TextBlock x:Name="ExportLabel" Text="필터 결과 내보내기" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="" Style="{StaticResource ToolbarIcon}" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock x:Name="FileLabel" Text="로그 원문" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Border x:Name="ContextPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="ContextStatus" TextWrapping="Wrap" FontWeight="SemiBold" />
              <TextBlock Text="스레드·내용 필터를 잠시 적용하지 않는 주변 보기입니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="기존 필터로 돌아가기" Click="ReturnContext_Click" Margin="10,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border x:Name="SearchBar" Grid.Row="2" Visibility="Collapsed" Padding="15,9" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" KeyDown="Search_KeyDown" AutomationProperties.Name="현재 표시 중인 로그 검색" ToolTip="현재 표시 중인 로그에서 검색" />
            <Button Grid.Column="1" Content="↑" Click="Previous_Click" ToolTip="이전 결과 · F4 / Shift+F3" AutomationProperties.Name="이전 검색 결과" Margin="8,0,3,0" />
            <Button Grid.Column="2" Content="↓" Click="Next_Click" ToolTip="다음 결과 · F3" AutomationProperties.Name="다음 검색 결과" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,12,0">
              <TextBlock x:Name="SearchStatus" FontSize="11" Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="SearchScopeStatus" Text="현재 표시 중인 기록" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="4" Content="×" Click="CloseSearch_Click" ToolTip="검색 닫기 · Esc" AutomationProperties.Name="검색 닫기" Margin="0" />
          </Grid>
          <WrapPanel Margin="0,8,0,0">
            <CheckBox x:Name="SearchCaseBox" Content="대소문자" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" Margin="0,0,12,0" />
            <CheckBox x:Name="SearchWordBox" Content="단어" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" Margin="0,0,12,0" />
            <CheckBox x:Name="SearchRegexBox" Content="정규식" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed" Margin="0,0,12,0" />
            <ComboBox x:Name="SearchScopeBox" Width="150" SelectedIndex="0" SelectionChanged="SearchScope_Changed" AutomationProperties.Name="검색 범위">
              <ComboBoxItem Content="현재 표시 기록" />
              <ComboBoxItem Content="전체 원본" />
              <ComboBoxItem Content="고정 선택 범위" />
            </ComboBox>
            <Button Content="선택 범위 지정" Click="CaptureSearchSelection_Click" FontSize="11" ToolTip="F3로 만든 선택과 별개로 현재 선택을 검색 범위로 고정" Margin="8,0" />
          </WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="3">
        <Border x:Name="SplitStatusPanel" Visibility="Collapsed" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,5">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="×" Click="SplitClear_Click" ToolTip="분리 시작 지정 해제" AutomationProperties.Name="분리 시작 지정 해제" Padding="5,0" MinHeight="24" />
            <TextBlock x:Name="SplitSummary" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
          </DockPanel>
        </Border>
        <Border x:Name="TimeResultPanel" Visibility="Collapsed" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,1" Padding="12,5" ToolTip="우클릭하여 결과 복사·기준 줄 이동·비교 줄 이동·지정 해제">
          <Border.ContextMenu><ContextMenu Opened="TimeResultMenu_Opened">
            <MenuItem Header="시간 차이 복사" Tag="time-pair" Click="CopyTime_Click" />
            <MenuItem Header="기준 줄로 이동" Tag="anchor-a" Click="GoTimeA_Click" />
            <MenuItem Header="비교 줄로 이동" Tag="anchor-b" Click="GoTimeB_Click" />
            <MenuItem Header="기준과 비교 바꾸기" Tag="time-pair" Click="SwapTime_Click" />
            <Separator /><MenuItem Header="시간 비교 해제" Click="ClearTime_Click" />
          </ContextMenu></Border.ContextMenu>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="×" Click="ClearTime_Click" ToolTip="시간 비교 해제" AutomationProperties.Name="시간 비교 해제" Padding="5,0" MinHeight="24" />
            <TextBlock x:Name="TimeSummary" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="ToolsScroll" Visibility="{Binding Visibility, ElementName=GoToPanel, FallbackValue=Collapsed}" MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border x:Name="GoToPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" Padding="12,6">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="×" Click="CloseGoTo_Click" ToolTip="닫기 · Esc" />
              <TextBlock Text="원본 줄" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="GoToBox" Width="105" HorizontalAlignment="Left" KeyDown="GoTo_KeyDown" AutomationProperties.Name="원본 줄 번호" />
              <Button Content="이동" Click="GoToSubmit_Click" Margin="8,0" />
              <Button x:Name="HiddenContextButton" Content="숨긴 줄 문맥" Click="HiddenContext_Click" Visibility="Collapsed" />
              <TextBlock x:Name="GoToStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <Expander x:Name="AnalysisPanel" Visibility="Collapsed" Header="로그 분석" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PanelBrush}" Padding="12,4">
            <StackPanel Margin="0,6,0,6">
              <WrapPanel>
                <RadioButton x:Name="ContextToolButton" Content="주변 로그" GroupName="AnalysisTool" Tag="0" Style="{StaticResource AnalysisToolTab}" IsChecked="True" Checked="AnalysisTool_Changed" />
                <RadioButton x:Name="TimeToolButton" Content="두 기록 시간 차이" GroupName="AnalysisTool" Tag="1" Style="{StaticResource AnalysisToolTab}" Checked="AnalysisTool_Changed" />
                <RadioButton x:Name="HighlightToolButton" Content="문구 강조" GroupName="AnalysisTool" Tag="2" Style="{StaticResource AnalysisToolTab}" Checked="AnalysisTool_Changed" />
              </WrapPanel>
              <TextBlock x:Name="CurrentRecordStatus" Text="로그에서 분석할 기록을 클릭하세요." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
              <StackPanel x:Name="ContextToolPanel">
                <TextBlock Text="선택한 기록 주변에서 다른 스레드가 한 일을 확인합니다." TextWrapping="Wrap" Margin="0,0,0,6" />
                <WrapPanel>
                  <TextBlock Text="앞뒤 각각" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox x:Name="ContextRadiusBox" Text="20" Width="55" AutomationProperties.Name="앞뒤 각각 표시할 기록 수" />
                  <TextBlock Text="기록" VerticalAlignment="Center" Margin="8,0" />
                  <Button x:Name="ContextOpenButton" Content="선택한 기록 주변 보기" Click="Context_Click" IsEnabled="False" />
                </WrapPanel>
                <TextBlock x:Name="ContextInputStatus" Text="로그를 클릭한 뒤 주변 보기를 누르세요. 기록은 헤더와 그 아래 본문을 묶은 단위입니다." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel x:Name="TimeToolPanel" Visibility="Collapsed">
                <TextBlock x:Name="TimeInstruction" Text="로그에서 기준 기록을 클릭하고 지정한 뒤, 비교할 기록을 클릭해 지정하세요." TextWrapping="Wrap" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Button x:Name="TimeALabel" Content="기준 (A): 아직 지정하지 않았습니다" Click="GoTimeA_Click" ToolTip="지정한 기준 기록으로 이동" IsEnabled="False" FontSize="12" HorizontalContentAlignment="Left"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Button.ContentTemplate></Button>
                  <Button x:Name="TimeAButton" Grid.Column="1" Content="현재 기록을 기준으로 지정" Click="TimeA_Click" IsEnabled="False" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Button x:Name="TimeBLabel" Content="비교 (B): 아직 지정하지 않았습니다" Click="GoTimeB_Click" ToolTip="지정한 비교 기록으로 이동" IsEnabled="False" FontSize="12" HorizontalContentAlignment="Left"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Button.ContentTemplate></Button>
                  <Button x:Name="TimeBButton" Grid.Column="1" Content="현재 기록을 비교로 지정" Click="TimeB_Click" IsEnabled="False" />
                </Grid>
                <WrapPanel Margin="0,6,0,0">
                  <TextBlock x:Name="TimeDifferenceStatus" Text="시간 차이는 두 기록을 지정하면 표시됩니다." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button x:Name="SwapTimeButton" Content="기준과 비교 바꾸기" Click="SwapTime_Click" IsEnabled="False" />
                  <Button x:Name="ClearTimeButton" Content="지정 해제" Click="ClearTime_Click" IsEnabled="False" />
                  <Button x:Name="CopyTimeButton" Content="시간 차이 복사" Click="CopyTime_Click" IsEnabled="False" />
                </WrapPanel>
              </StackPanel>
              <StackPanel x:Name="HighlightToolPanel" Visibility="Collapsed">
                <TextBlock Text="입력한 문구를 지정한 색으로 표시합니다. 최대 8개 규칙을 함께 사용할 수 있습니다." TextWrapping="Wrap" Margin="0,0,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBlock Text="강조할 문구" FontSize="12" /><TextBlock Text="색상" Grid.Column="1" FontSize="12" Margin="8,0" />
                  <TextBox x:Name="KeywordBox" Grid.Row="1" MinWidth="100" ToolTip="예: timeout, retry, 명령 ID · 일반 문자열" AutomationProperties.Name="강조할 문구" TextChanged="KeywordInput_Changed" KeyDown="Keyword_KeyDown" />
                  <ComboBox x:Name="KeywordColorBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="8,0" AutomationProperties.Name="강조 색상"><ComboBoxItem Content="주황" /><ComboBoxItem Content="보라" /><ComboBoxItem Content="청록" /><ComboBoxItem Content="파랑" /><ComboBoxItem Content="분홍" /><ComboBoxItem Content="초록" /></ComboBox>
                  <Button x:Name="KeywordAddButton" Grid.Row="1" Grid.Column="2" Content="강조 규칙 추가" Click="AddKeyword_Click" IsEnabled="False" />
                </Grid>
                <TextBlock Text="예: timeout · 입력 후 Enter 또는 강조 규칙 추가" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                <TextBlock x:Name="KeywordStatus" FontSize="11" Text="0/8 규칙" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="KeywordEmptyHint" Text="등록한 강조 문구가 없습니다." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                <ListBox x:Name="KeywordList" MaxHeight="86" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3">
                  <Button DockPanel.Dock="Right" Content="삭제" Tag="{Binding}" Click="RemoveKeyword_Click" FontSize="11" Padding="6,2" MinHeight="24" />
                  <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Label}" /></StackPanel></CheckBox>
                </DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
        </ScrollViewer>
        </StackPanel>
        <avalon:TextEditor x:Name="Editor" Grid.Row="4" PreviewMouseLeftButtonDown="Editor_LeftButtonDown" PreviewMouseRightButtonDown="Editor_RightButtonDown" PreviewMouseRightButtonUp="Editor_RightButtonUp" IsReadOnly="True" AllowDrop="True" ShowLineNumbers="False" FontFamily="Consolas, D2Coding, Malgun Gothic" FontSize="14" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0,10,10,8" AutomationProperties.Name="로그 원문">
          <avalon:TextEditor.ContextMenu>
            <ContextMenu x:Name="LineContextMenu" Opened="LineContext_Opened" Closed="LineContext_Closed">
              <MenuItem Header="로그의 줄을 우클릭하세요" Tag="line-title" IsEnabled="False" />
              <Separator />
              <MenuItem Header="세션 분리 시작 · 이 줄부터" Tag="line" Click="SplitStart_Click" />
              <MenuItem Header="세션 분리 끝 · 여기까지 새 탭으로" Tag="split-end" Click="SplitEnd_Click" ToolTip="시작과 끝 줄을 포함합니다. 사이의 숨겨진 원본 줄도 포함합니다." />
              <MenuItem Header="분리 시작 지정 해제" Tag="split-clear" Click="SplitClear_Click" />
              <Separator />
              <MenuItem Header="시간 비교 기준 · 이 줄로 지정" Tag="time" Click="TimeA_Click" />
              <MenuItem Header="기준과 이 줄 시간 차이" Tag="time-compare" Click="TimeB_Click" />
              <MenuItem Header="시간 비교 결과" Tag="time-clear">
                <MenuItem Header="시간 차이 복사" Tag="time-pair" Click="CopyTime_Click" />
                <MenuItem Header="기준 줄로 이동" Tag="anchor-a" Click="GoTimeA_Click" />
                <MenuItem Header="비교 줄로 이동" Tag="anchor-b" Click="GoTimeB_Click" />
                <MenuItem Header="시간 비교 해제" Tag="time-clear" Click="ClearTime_Click" />
              </MenuItem>
              <Separator />
              <MenuItem Header="문구 강조 / 해제" InputGestureText="Shift+F8" Tag="highlight" Click="ToggleHighlight_Click" />
              <MenuItem Header="강조 문구 관리…" Tag="highlight-manager" Click="HighlightSelection_Click" />
              <MenuItem Header="이 줄 주변 로그 보기" Tag="line" Click="Context_Click" />
              <MenuItem Header="주변 로그 범위" Tag="line">
                <MenuItem Header="앞뒤 5기록" Tag="5" Click="ContextRadius_Click" />
                <MenuItem Header="앞뒤 20기록" Tag="20" Click="ContextRadius_Click" />
                <MenuItem Header="앞뒤 100기록" Tag="100" Click="ContextRadius_Click" />
                <Separator /><MenuItem Header="직접 지정…" Click="ContextRadiusCustom_Click" />
              </MenuItem>
              <Separator />
              <MenuItem Header="이동·북마크" Tag="line">
                <MenuItem Header="원본 줄 이동…" InputGestureText="Ctrl+G" Tag="line" Click="GoTo_Click" />
                <MenuItem Header="이 줄 북마크 표시 / 해제" InputGestureText="Ctrl+F2" Tag="line" Click="BookmarkToggle_Click" />
                <MenuItem Header="이 줄 북마크 이름…" Tag="line" Click="BookmarkRename_Click" />
              </MenuItem>
              <MenuItem Header="텍스트">
                <MenuItem Header="복사" InputGestureText="Ctrl+C" Click="Copy_Click" />
                <MenuItem Header="전체 선택" InputGestureText="Ctrl+A" Click="SelectText_Click" />
                <MenuItem Header="클립보드 로그 새 탭으로 열기" InputGestureText="Ctrl+V / Ctrl+Shift+V" Click="PasteLog_Click" />
              </MenuItem>
            </ContextMenu>
          </avalon:TextEditor.ContextMenu>
        </avalon:TextEditor>
        <StackPanel x:Name="EmptyPanel" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" />
          <TextBlock x:Name="EmptyHint" Text="로그 파일을 여기에 끌어 놓으세요" TextAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="17" />
          <TextBlock x:Name="EmptyDetail" Text=".log / .txt 파일 열기  ·  Ctrl+V로 로그 붙여넣기" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
        </StackPanel>
        <Border x:Name="ResultsPanel" Grid.Row="5" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="검색 결과 · 원본 줄 / 소유 헤더 시간 / 스레드" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
            <ListBox x:Name="ResultsList" Height="135" SelectionChanged="Result_Selected" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" DisplayMemberPath="Label" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
