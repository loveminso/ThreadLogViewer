<Window x:Class="ThreadLogViewer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Title="ThreadLog Viewer v0.2.0" Width="1360" Height="860" MinWidth="1040" MinHeight="600" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" PreviewKeyDown="Window_KeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" PreviewDragEnter="Window_DragOver" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Click="Open_Click" ToolTip="파일 열기 · Ctrl+O" AutomationProperties.Name="파일 열기">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="" />
              <TextBlock Text="파일 열기" />
            </StackPanel>
          </Button>
          <Button Click="Paste_Click" ToolTip="Ctrl+V · 복사한 텍스트 또는 파일을 새 로그로 열기" AutomationProperties.Name="붙여넣기">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="" />
              <TextBlock Text="붙여넣기" />
            </StackPanel>
          </Button>
          <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="8,0,12,0" />
          <Button Click="Search_Click" ToolTip="현재 표시 중인 로그 검색 · Ctrl+F" AutomationProperties.Name="검색">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="" />
              <TextBlock Text="검색" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ToggleButton x:Name="WrapBox" Checked="Wrap_Changed" Unchecked="Wrap_Changed" ToolTip="자동 줄바꿈" AutomationProperties.Name="자동 줄바꿈">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource ToolbarIcon}" Text="" />
              <TextBlock Text="줄바꿈" />
            </StackPanel>
          </ToggleButton>
          <ComboBox x:Name="FontSizeBox" Width="72" Margin="0,0,8,0" SelectionChanged="FontSize_Changed" SelectedIndex="3" ToolTip="로그 글자 크기" AutomationProperties.Name="글자 크기">
            <ComboBoxItem Content="11" />
            <ComboBoxItem Content="12" />
            <ComboBoxItem Content="13" />
            <ComboBoxItem Content="14" />
            <ComboBoxItem Content="16" />
            <ComboBoxItem Content="18" />
            <ComboBoxItem Content="20" />
            <ComboBoxItem Content="24" />
          </ComboBox>
          <ComboBox x:Name="DensityBox" Width="103" Margin="0,0,8,0" SelectionChanged="Density_Changed" SelectedIndex="0" ToolTip="로그 행 간격" AutomationProperties.Name="로그 행 간격">
            <ComboBoxItem Content="기본 간격" />
            <ComboBoxItem Content="좁은 간격" />
          </ComboBox>
          <ComboBox x:Name="ThemeBox" Width="85" SelectionChanged="Theme_Changed" SelectedIndex="0" ToolTip="화면 테마" AutomationProperties.Name="화면 테마">
            <ComboBoxItem Content="다크" />
            <ComboBoxItem Content="라이트" />
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CountStatus" Text="표시 0 / 전체 0줄" FontSize="11" ToolTip="{Binding Text, ElementName=OperationStatus}" VerticalAlignment="Center" />
        <TextBlock x:Name="EncodingStatus" Grid.Column="1" Text="인코딩: 파일 없음" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="20,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" />
        <TextBlock x:Name="ParseStatus" Grid.Column="2" Text="파싱: 대기" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="읽기 전용" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="20,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border x:Name="WorkPanel" DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="작업 취소" Click="Cancel_Click" Visibility="Collapsed" />
        <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Right" Width="150" Height="5" Minimum="0" Maximum="100" Margin="10,0,15,0" Visibility="Collapsed" />
        <TextBlock x:Name="OperationStatus" Text="로그 파일을 끌어 놓거나 Ctrl+V로 붙여넣으세요." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="275" MinWidth="245" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PanelBrush}">
        <DockPanel x:Name="FilterPanel" Margin="12,18,12,10">
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="6,0,6,12">
              <TextBlock Text="스레드" FontWeight="SemiBold" />
              <TextBlock x:Name="ThreadCount" Text="0개" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="전체 선택" Click="SelectAll_Click" FontSize="12" Padding="7,5" MinHeight="28" />
              <Button Content="전체 해제" Click="SelectNone_Click" FontSize="12" Padding="7,5" MinHeight="28" />
            </StackPanel>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="최초 → 마지막 기록 · 파일 순서" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="6,12,0,0" />
          <ListBox x:Name="ThreadList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="7,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="단독" ToolTip="이 스레드만 보기" Padding="5,2" FontSize="11" MinHeight="24" Margin="4,0,0,0" Tag="{Binding}" Click="Only_Click" />
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Fill="{Binding Color}" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        </StackPanel>
                      </CheckBox>
                      <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Times}" ToolTip="{Binding DetailedTimes}" FontFamily="Consolas, Malgun Gothic" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="24,8,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,9">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="ReloadButton" Content="CP949로 다시 읽기" Click="Reload_Click" IsEnabled="False" FontSize="12" />
              <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="False" ToolTip="표시 중인 로그를 새 UTF-8 파일로 내보내기" AutomationProperties.Name="필터 결과 내보내기">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ToolbarIcon}" Text="" />
                  <TextBlock Text="필터 결과 내보내기" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="" Style="{StaticResource ToolbarIcon}" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock x:Name="FileLabel" Text="로그 원문" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Border x:Name="SearchBar" Grid.Row="1" Visibility="Collapsed" Padding="15,9" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" KeyDown="Search_KeyDown" AutomationProperties.Name="현재 표시 중인 로그 검색" ToolTip="현재 표시 중인 로그에서 검색" />
            <Button Grid.Column="1" Content="↑" Click="Previous_Click" ToolTip="이전 결과 · Shift+F3" AutomationProperties.Name="이전 검색 결과" Margin="8,0,3,0" />
            <Button Grid.Column="2" Content="↓" Click="Next_Click" ToolTip="다음 결과 · F3" AutomationProperties.Name="다음 검색 결과" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,12,0">
              <TextBlock x:Name="SearchStatus" FontSize="11" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="현재 표시 중인 로그" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="4" Content="×" Click="CloseSearch_Click" ToolTip="검색 닫기 · Esc" AutomationProperties.Name="검색 닫기" Margin="0" />
          </Grid>
        </Border>
        <avalon:TextEditor x:Name="Editor" Grid.Row="2" IsReadOnly="True" AllowDrop="True" ShowLineNumbers="False" FontFamily="Consolas, D2Coding, Malgun Gothic" FontSize="14" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0,10,10,8" AutomationProperties.Name="로그 원문">
          <avalon:TextEditor.ContextMenu>
            <ContextMenu>
              <MenuItem Header="복사" InputGestureText="Ctrl+C" Click="Copy_Click" />
              <MenuItem Header="전체 선택" InputGestureText="Ctrl+A" Click="SelectText_Click" />
              <Separator />
              <MenuItem Header="붙여넣은 로그 열기" InputGestureText="Ctrl+V" Click="Paste_Click" />
            </ContextMenu>
          </avalon:TextEditor.ContextMenu>
        </avalon:TextEditor>
        <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" />
          <TextBlock x:Name="EmptyHint" Text="로그 파일을 여기에 끌어 놓으세요" TextAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="17" />
          <TextBlock x:Name="EmptyDetail" Text=".log / .txt 파일 열기  ·  Ctrl+V로 로그 붙여넣기" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>