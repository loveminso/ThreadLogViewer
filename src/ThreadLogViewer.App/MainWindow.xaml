<Window x:Class="ThreadLogViewer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="ThreadLog Viewer v0.1" Width="1360" Height="860" MinWidth="1000" MinHeight="600" FontFamily="Malgun Gothic" FontSize="13" Background="#F6F7F9" Foreground="#202936" PreviewKeyDown="Window_KeyDown"
        AllowDrop="True" PreviewDragEnter="Window_DragOver" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D8DEE7" BorderThickness="0,0,0,1" Padding="14,12">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <TextBlock Text="ThreadLog Viewer" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="v0.1 · 읽기 전용" Foreground="#657084" VerticalAlignment="Center" Margin="14,0,0,0" />
        </DockPanel>
        <WrapPanel>
          <Button Content="파일 열기…" Click="Open_Click" ToolTip="Ctrl+O · .log / .txt" />
          <Button Content="붙여넣기 (Ctrl+V)" Click="Paste_Click" ToolTip="복사한 로그 텍스트 또는 파일을 열기 · 현재 표시 내용을 대체합니다." />
          <Button x:Name="ReloadButton" Content="CP949로 다시 읽기" Click="Reload_Click" IsEnabled="False" />
          <Button Content="검색 (Ctrl+F)" Click="Search_Click" />
          <CheckBox x:Name="WrapBox" Content="자동 줄바꿈" VerticalAlignment="Center" Margin="12,0,14,0" Checked="Wrap_Changed" Unchecked="Wrap_Changed" />
          <TextBlock Text="글자 크기" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="FontSizeBox" Width="65" VerticalContentAlignment="Center" SelectionChanged="FontSize_Changed" SelectedIndex="3" Margin="0,0,16,0">
            <ComboBoxItem Content="11" /><ComboBoxItem Content="12" /><ComboBoxItem Content="13" /><ComboBoxItem Content="14" /><ComboBoxItem Content="16" /><ComboBoxItem Content="18" /><ComboBoxItem Content="20" /><ComboBoxItem Content="24" />
          </ComboBox>
          <Button x:Name="ExportButton" Content="필터 결과 내보내기…" Click="Export_Click" IsEnabled="False" ToolTip="표시 중인 로그를 새 UTF-8 파일로 내보내기" />
        </WrapPanel>
        <DockPanel x:Name="SearchBar" Visibility="Collapsed" Margin="0,10,0,0">
          <TextBlock Text="현재 표시 중인 로그에서 검색" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#526076" />
          <TextBox x:Name="SearchBox" Width="250" Padding="6" TextChanged="Search_Changed" KeyDown="Search_KeyDown" />
          <Button Content="이전 (Shift+F3)" Click="Previous_Click" Margin="8,0,6,0" />
          <Button Content="다음 (F3)" Click="Next_Click" />
          <Button Content="닫기" Click="CloseSearch_Click" />
          <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Foreground="#526076" />
        </DockPanel>
      </StackPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="White" Padding="10,6">
      <StatusBarItem><TextBlock x:Name="CountStatus" Text="표시 0 / 전체 0줄" /></StatusBarItem><Separator />
      <StatusBarItem><TextBlock x:Name="EncodingStatus" Text="인코딩: 파일 없음" /></StatusBarItem><Separator />
      <StatusBarItem><TextBlock x:Name="ParseStatus" Text="파싱: 대기" /></StatusBarItem>
    </StatusBar>
    <Border DockPanel.Dock="Bottom" BorderBrush="#D8DEE7" BorderThickness="0,1,0,0" Padding="14,8">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="작업 취소" Click="Cancel_Click" Visibility="Collapsed" />
        <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Right" Width="150" Height="12" Minimum="0" Maximum="100" Margin="10,0,15,0" Visibility="Collapsed" />
        <TextBlock x:Name="OperationStatus" Text="로그 파일을 끌어 놓거나 Ctrl+V로 로그를 붙여넣으세요." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="265" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <DockPanel x:Name="FilterPanel" Margin="12">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="스레드 필터" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9" />
          <WrapPanel Margin="0,0,0,8"><Button Content="전체 선택" Click="SelectAll_Click" /><Button Content="전체 해제" Click="SelectNone_Click" /></WrapPanel>
          <TextBlock Text="최초 / 마지막 기록 · 파일 기록 순서 기준" FontSize="11" Foreground="#657084" Margin="0,0,0,8" />
        </StackPanel>
        <ListBox x:Name="ThreadList" BorderBrush="#D8DEE7" Background="White" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="4,8" BorderBrush="#E8EBF0" BorderThickness="0,0,0,1">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="단독" ToolTip="이 스레드만 보기" Padding="7,1" MinHeight="23" Margin="4,0,0,0" Tag="{Binding}" Click="Only_Click" />
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal"><Rectangle Fill="{Binding Color}" Stroke="#9CA5B3" Width="13" Height="13" Margin="0,0,7,0" /><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /></StackPanel>
                    </CheckBox>
                    <TextBlock Text="{Binding CountLabel}" Foreground="#526076" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0" />
                  </DockPanel>
                  <TextBlock Text="{Binding Times}" FontSize="11" Foreground="#526076" Margin="22,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D8DEE7" />
      <Grid Grid.Column="2" Margin="0,12,12,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#D8DEE7" BorderThickness="1,1,1,0" Padding="10,8">
          <TextBlock x:Name="FileLabel" Text="원본 줄 번호  |  로그 원문" TextTrimming="CharacterEllipsis" Foreground="#526076" />
        </Border>
        <Border Grid.Row="1" BorderBrush="#D8DEE7" BorderThickness="1" Background="White">
          <avalon:TextEditor x:Name="Editor" IsReadOnly="True" AllowDrop="True" ShowLineNumbers="False" FontFamily="Consolas, D2Coding, Malgun Gothic" FontSize="14" Background="White" Foreground="#152030" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0,4,4,4">
            <avalon:TextEditor.ContextMenu>
              <ContextMenu>
                <MenuItem Header="복사" InputGestureText="Ctrl+C" Click="Copy_Click" />
                <MenuItem Header="전체 선택" InputGestureText="Ctrl+A" Click="SelectText_Click" />
                <Separator />
                <MenuItem Header="붙여넣은 로그 열기" InputGestureText="Ctrl+V" Click="Paste_Click" />
              </ContextMenu>
            </avalon:TextEditor.ContextMenu>
          </avalon:TextEditor>
        </Border>
        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text=".log / .txt 파일을 끌어 놓으세요.&#10;또는 로그 텍스트를 복사한 뒤 Ctrl+V" TextAlignment="Center" Foreground="#657084" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
